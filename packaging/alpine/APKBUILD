# Contributor: Vithurshan Selvarajah
# Maintainer: Vithurshan Selvarajah <noreply@example.com>
#
# Alpine has no Tauri bundle target for .apk, so the package is built by
# hand.
#
# The build is not done by this APKBUILD alone. The frontend, the Rust
# application and the Go sidecar are built inside the container that
# scripts/build-alpine.sh starts, because a cross build from a glibc
# runner would link against the wrong GTK and WebKitGTK. Those builds
# happen first and their output is staged into the source tree that this
# APKBUILD packages. The build() function below therefore assembles what
# has already been built rather than building it.
#
# The staging is done by scripts/alpine-build-inner.sh, which also writes
# the sha512sums line. The checksum is not in this file because the
# source is a tarball that is made per build, not a fixed download.

pkgname=ha-panel
pkgver=0.1.0
pkgrel=0
pkgdesc="A lightweight Home Assistant kiosk for wall-mounted displays"
arch="x86_64 aarch64 armv7"
url="https://github.com/vithurshanselvarajah/HA-Panel"
license="MIT"
depends="$pkgname-runtime"
makedepends="
	build-base
	ca-certificates
	"
# The script that creates the kiosk user. Alpine's apk does not create
# the users a package declares, so this runs at install time instead.
install="$pkgname.pre-install"
subpackages="$pkgname-runtime $pkgname-doc $pkgname-openrc"
source="$pkgname-$pkgver.tar.gz"
options="!check"

# The kiosk user and its group. The application runs as this user, and
# the configuration directory is shared with it.
pkggroups="ha-panel"
pkgusers="ha-panel"

build() {
	# Everything is already built and staged into the source tree.
	# The check here is that the pieces this package needs are present,
	# because a missing one would otherwise produce a package that
	# installs and then fails to start.
	for file in ha-panel ha-panel-sidecar; do
		if [ ! -f "$builddir/$file" ]; then
			echo "$file was not staged into the source tree" >&2
			return 1
		fi
	done
}

package() {
	# The application and its sidecar. They sit in the same directory
	# because the application looks for the sidecar next to itself.
	install -Dm755 "$builddir/ha-panel" "$pkgdir/usr/bin/ha-panel"
	install -Dm755 "$builddir/ha-panel-sidecar" "$pkgdir/usr/bin/ha-panel-sidecar"

	# The configuration. The directory is owned by root and shared with
	# the kiosk group, so that the kiosk user can write its settings
	# there without being able to read the directory's other contents.
	install -d -m 0770 -o root -g ha-panel "$pkgdir/etc/ha-panel"
	install -m 0660 -o ha-panel -g ha-panel \
		"$builddir/etc-ha-panel-config.json" \
		"$pkgdir/etc/ha-panel/config.json"

	# The state and cache directories. The application keeps its log in
	# memory and only writes here when it has to.
	install -d -m 0750 -o ha-panel -g ha-panel "$pkgdir/var/lib/ha-panel"
	install -d -m 0750 -o ha-panel -g ha-panel "$pkgdir/var/cache/ha-panel"

	# The desktop entry and the icons, for a device that has a desktop
	# session.
	install -Dm644 "$builddir/packaging/ha-panel.desktop" \
		"$pkgdir/usr/share/applications/ha-panel.desktop"
	for size in 32 128 256 512; do
		install -Dm644 "$builddir/icons/${size}x${size}.png" \
			"$pkgdir/usr/share/icons/hicolor/${size}x${size}/apps/ha-panel.png"
	done

	install -Dm644 "$builddir/LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"

	# The documentation. This goes under usr/share/doc, which is where
	# abuild's own doc subpackage looks for it.
	install -Dm644 "$builddir/README.md" "$pkgdir/usr/share/doc/$pkgname/README.md"
	for doc in architecture configuration installation; do
		install -Dm644 "$builddir/docs/$doc.md" \
			"$pkgdir/usr/share/doc/$pkgname/$doc.md"
	done

	# The OpenRC service. It goes into the root package and is moved
	# into the openrc subpackage by amove, which is how abuild splits a
	# file from one package into another.
	install -d "$pkgdir/etc/init.d"
	install -Dm755 "$builddir/packaging/ha-panel.initd" \
		"$pkgdir/etc/init.d/ha-panel"
}

runtime() {
	# This is a virtual package: it holds the runtime dependencies but
	# no files. It is built as a subpackage so that the dependencies can
	# be listed once and pulled in with the application.
	#
	# The directory is created with $subpkgdir, not $pkgdir: a split
	# function's $pkgdir is the root package's directory, so writing
	# there would put the files in the wrong package.
	pkgdesc="The runtime for ha-panel"
	depends="
		alsa-utils
		ca-certificates
		gtk+3.0
		libx11
		libxkbcommon
		mesa-dri-gallium
		networkmanager
		webkit2gtk-4.1
		wlopm
		wpa_supplicant
		xset
		"
	install -d "$subpkgdir"
}

openrc() {
	pkgdesc="The OpenRC service for ha-panel"
	amove etc/init.d
}
